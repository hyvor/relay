{% extends '@Internal/mail/mail.html.twig' %}

{% block title %}
    {{ strings.subject }}
{% endblock %}

{% block heading %}
    {{ strings.subject }}
{% endblock %}

{% block content %}
    <p>Hi {{ strings.name }},</p>

    <p>
        {{ strings.body_main}}
    </p>

    {% if reject_reason is defined and reject_reason %}
        <div style="max-width:90%;background-color:#fafafa;border:1px solid #e1e1e1;border-radius:20px;padding:15px 20px;margin:20px auto;text-align:center;">
            <strong>Reject Reason:</strong> {{ reject_reason }}
        </div>
    {% endif %}

    {% if strings.body_secondary is defined %}
        <p>
            {{ strings.body_secondary }}
        </p>
    {% endif %}

    {% if billing_url is defined %}
        <twig:mail:button href="{{ billing_url }}">Visit Billing</twig:mail:button>
    {% endif %}

    <p>
        If you have any questions or need assistance, please don't hesitate to 
        contact our support team.
    </p>

    <p>
        Best regards
        <br/>
        HYVOR
    </p>
{% endblock %}
